{
  "version": 1,

  "canvas": {
    "width_px": 800,
    "height_px": 600,
    "dpi": 100
  },

  "margins": {
    "left": 0.14,
    "right": 0.05,
    "bottom": 0.14,
    "top": 0.08,
    "right_colz": 0.16
  },

  "font": {
    "family": "TeX Gyre Heros",
    "fallbacks": ["Nimbus Sans", "Helvetica", "Arial", "Liberation Sans", "DejaVu Sans"],
    "root_regular": 42
  },

  "text": {
    "axis_title_size": 0.045,
    "axis_label_size": 0.04,
    "legend_size": 0.035,
    "label_size": 0.045,
    "info_size": 0.035
  },

  "axes": {
    "ticks_all_sides": true,
    "minor_ticks": true,
    "tick_length": 0.03,
    "minor_tick_length": 0.015,
    "ndivisions": 510,
    "frame_width_px": 1,
    "x_title_loc": "right",
    "y_title_loc": "top",
    "title_offset_x": 0.98,
    "title_offset_y": 1.33
  },

  "lines": {
    "width_px": 2,
    "marker_size_px": 9
  },

  "palette": {
    "name": "ALLEGRO",
    "reference": "logo navy / blue / yellow + colours checked with tests/cvd.py",
    "colors": ["#0f0f4b", "#1a75bc", "#e8c200", "#bd1f01", "#92dadd", "#a96b59"]
  },

  "markers": {
    "root": [20, 21, 22, 23, 33, 24, 25, 26, 32, 27],
    "mpl": ["o", "s", "^", "v", "d", "o", "s", "^", "v", "d"],
    "mpl_scale": [1, 1, 1, 1, 0.75, 1, 1, 1, 1, 0.75],
    "filled": [true, true, true, true, true, false, false, false, false, false]
  },

  "line_styles": {
    "root": [1, 2, 3, 4],
    "dashes_root": ["", "40 24", "8 16", "40 16 8 16"]
  },

  "colormap": {
    "name": "viridis",
    "stops": ["#440154", "#472d7b", "#3b528b", "#2c728e", "#21918c",
              "#28ae80", "#5ec962", "#addc30", "#fde725"]
  },

  "label": {
    "experiment": "ALLEGRO",
    "status": "Simulation",
    "x": 0.0,
    "y": 1.012,
    "align": "left"
  },

  "info": {
    "x": 0.04,
    "y": 0.95,
    "align": "left",
    "valign": "top",
    "line_spacing": 1.35,
    "energy_unit": "GeV",
    "lumi_unit_mpl": "ab$^{-1}$",
    "lumi_unit_root": "ab#kern[-0.5]{^{#minus1}}"
  },

  "legend": {
    "x": 0.96,
    "y": 0.95,
    "align": "right",
    "width": 0.3,
    "row_height": 0.05,
    "margin": 0.25
  }
}
